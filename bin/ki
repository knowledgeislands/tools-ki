#!/usr/bin/env bash

set -eu

KI_VERSION="0.2.0"
CONNECTOR_ID="knowledgeislands.chatgpt.local-capture"
CONNECTOR_VERSION="0.1.0"

root_help() {
  cat <<'EOF'
Usage: ki <command>

Knowledge Islands command-line interface.

Commands:
  acquire             Import a local user-prepared capture.
  completion(s)       Print Bash or Zsh completion.
  doctor              Report CLI installation and XDG paths.
  help [command]      Show command help.
  paths               Print the resolved XDG paths used by KI.

Options:
  -h, --help          Show this help.
  -V, --version       Show the CLI version.
EOF
}

doctor_help() {
  cat <<'EOF'
Usage: ki doctor

Report the current CLI installation mode and resolved XDG paths. This command does not create, inspect, or change repository or user state.
EOF
}

completion_help() {
  cat <<'EOF'
Usage: ki completion <bash|zsh>
       ki completions <bash|zsh>

Print shell completion source to standard output.
EOF
}

paths_help() {
  cat <<'EOF'
Usage: ki paths

Print the resolved XDG paths used for KI user data, configuration, cache, and state. This command does not create those paths.
EOF
}

acquire_help() {
  cat <<'EOF'
Usage: ki acquire chatgpt import <capture-directory> --output <kep-directory> [--dry-run] [--json]

Import a user-prepared local ChatGPT capture into an immutable Knowledge Export Package (KEP).
EOF
}

chatgpt_help() {
  cat <<'EOF'
Usage: ki acquire chatgpt import <capture-directory> --output <kep-directory> [--dry-run] [--json]

The ChatGPT acquisition group currently provides the local capture importer.
EOF
}

import_help() {
  cat <<'EOF'
Usage: ki acquire chatgpt import <capture-directory> --output <kep-directory> [--dry-run] [--json]

Validate a user-prepared local capture and create a deterministic Knowledge Export Package (KEP).

The capture directory must follow the controlled local-capture layout. The importer never controls a browser, contacts ChatGPT, reads credentials or browser profiles, discovers a repository, or extracts knowledge.

Options:
  --output <kep-directory>  Required new output directory for the KEP.
  --dry-run                 Validate and report the deterministic output without writing it.
  --json                    Emit a versioned JSON result.
  -h, --help                Show this help.
EOF
}

grammar_error() {
  printf 'ki: error: %s\n' "$1" >&2
  printf "ki: try 'ki help %s'\n" "$2" >&2
  exit 2
}

operation_error() {
  printf 'ki: error: %s\n' "$1" >&2
  exit 1
}

unavailable() {
  printf 'ki: error: ki %s is not available in this release\n' "$1" >&2
  exit 2
}

completion() {
  case "$1" in
    bash) printf '%s\n' 'complete -W "acquire completion completions doctor help paths --help --version" ki' ;;
    zsh) printf '%s\n' '#compdef ki' '_arguments "1: :((acquire completion completions doctor help paths))"' ;;
    *) grammar_error "completion shell must be bash or zsh" "completion" ;;
  esac
}

ki_paths() {
  local xdg_data xdg_config xdg_cache xdg_state

  xdg_data=${XDG_DATA_HOME:-"$HOME/.local/share"}
  xdg_config=${XDG_CONFIG_HOME:-"$HOME/.config"}
  xdg_cache=${XDG_CACHE_HOME:-"$HOME/.cache"}
  xdg_state=${XDG_STATE_HOME:-"$HOME/.local/state"}
  printf 'data: %s/ki\n' "$xdg_data"
  printf 'config: %s/ki\n' "$xdg_config"
  printf 'cache: %s/ki\n' "$xdg_cache"
  printf 'state: %s/ki\n' "$xdg_state"
}

doctor() {
  local installation

  installation='regular executable'
  [ ! -L "$0" ] || installation='linked development checkout'
  printf 'ki version: %s\n' "$KI_VERSION"
  printf 'installation: %s\n' "$installation"
  ki_paths
}

physical_directory() {
  [ -d "$1" ] || return 1
  (CDPATH='' cd -P -- "$1" && pwd)
}

list_files() {
  (
    CDPATH='' cd -- "$1"
    find . -type f -print | LC_ALL=C sort | sed 's|^\./||'
  )
}

valid_relative_path() {
  case "$1" in
    "" | /* | *//* | . | .. | ./* | ../* | */./* | */../*) return 1 ;;
  esac
  [[ "$1" =~ ^[A-Za-z0-9._/-]+$ ]]
}

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    operation_error "a SHA-256 utility is required (shasum or sha256sum)"
  fi
}

sha256_stdin() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  else
    operation_error "a SHA-256 utility is required (shasum or sha256sum)"
  fi
}

validate_metadata() {
  local metadata="$1"
  local line value format_seen version_seen boundary_seen omissions_seen boundary_pattern omissions_pattern

  CAPTURE_BOUNDARY=""
  OMISSIONS=""
  format_seen=0
  version_seen=0
  boundary_seen=0
  omissions_seen=0
  boundary_pattern='^[A-Za-z0-9][A-Za-z0-9 .,:;()/_-]*$'
  omissions_pattern='^\[("[A-Za-z0-9 .,:;()/_-]+"(,"[A-Za-z0-9 .,:;()/_-]+")*)?\]$'

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "" | \#*) ;;
      'format = "'*'"')
        [ "$format_seen" -eq 0 ] || operation_error "capture metadata repeats format"
        value=${line#format = \"}
        value=${value%\"}
        [ "$value" = "ki-chatgpt-capture" ] || operation_error "capture metadata format must be ki-chatgpt-capture"
        format_seen=1
        ;;
      'format_version = "'*'"')
        [ "$version_seen" -eq 0 ] || operation_error "capture metadata repeats format_version"
        value=${line#format_version = \"}
        value=${value%\"}
        [ "$value" = "0.1.0" ] || operation_error "capture metadata format_version must be 0.1.0"
        version_seen=1
        ;;
      'capture_boundary = "'*'"')
        [ "$boundary_seen" -eq 0 ] || operation_error "capture metadata repeats capture_boundary"
        value=${line#capture_boundary = \"}
        value=${value%\"}
        [[ "$value" =~ $boundary_pattern ]] || operation_error "capture_boundary contains unsupported characters"
        CAPTURE_BOUNDARY="$value"
        boundary_seen=1
        ;;
      'omissions = '* )
        [ "$omissions_seen" -eq 0 ] || operation_error "capture metadata repeats omissions"
        value=${line#omissions = }
        [[ "$value" =~ $omissions_pattern ]] || operation_error "omissions must be a compact array of plain strings"
        OMISSIONS="$value"
        omissions_seen=1
        ;;
      *) operation_error "capture metadata contains an unsupported field" ;;
    esac
  done < "$metadata"

  [ "$format_seen" -eq 1 ] || operation_error "capture metadata is missing format"
  [ "$version_seen" -eq 1 ] || operation_error "capture metadata is missing format_version"
  [ "$boundary_seen" -eq 1 ] || operation_error "capture metadata is missing capture_boundary"
  [ "$omissions_seen" -eq 1 ] || operation_error "capture metadata is missing omissions"
}

validate_files() {
  local directory="$1"
  local kind="$2"
  local relative count

  count=0
  while IFS= read -r relative; do
    valid_relative_path "$relative" || operation_error "$kind contains an unsafe path"
    [ -f "$directory/$relative" ] && [ ! -L "$directory/$relative" ] || operation_error "$kind contains an unsafe file"
    if [ "$kind" = "records" ] && [[ "$relative" != *.md ]]; then
      operation_error "records must use Markdown file names"
    fi
    count=$((count + 1))
  done < <(list_files "$directory")
  printf '%s\n' "$count"
}

validate_relationships() {
  local file="$1"
  local line record asset position seen_positions
  local order_pattern asset_pattern project_pattern

  [ -f "$file" ] && [ ! -L "$file" ] || operation_error "relationships/native.jsonl is required"
  order_pattern='^\{"type":"conversation-order","record":"records/([A-Za-z0-9._/-]+)","position":([1-9][0-9]*)\}$'
  asset_pattern='^\{"type":"message-asset","record":"records/([A-Za-z0-9._/-]+)","asset":"assets/([A-Za-z0-9._/-]+)","message_id":"([A-Za-z0-9._:-]+)"\}$'
  project_pattern='^\{"type":"project-conversation","record":"records/([A-Za-z0-9._/-]+)","project_id":"([A-Za-z0-9._:-]+)"\}$'
  seen_positions="|"
  RELATIONSHIP_COUNT=0

  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || operation_error "relationships/native.jsonl contains a blank record"
    if [[ "$line" =~ $order_pattern ]]; then
      record=${BASH_REMATCH[1]}
      position=${BASH_REMATCH[2]}
      valid_relative_path "$record" || operation_error "relationship record path is unsafe"
      [ -f "$CAPTURE_RECORDS/$record" ] || operation_error "relationship references a missing record"
      case "$seen_positions" in *"|$position|"*) operation_error "relationship repeats a conversation position" ;; esac
      seen_positions="${seen_positions}${position}|"
    elif [[ "$line" =~ $asset_pattern ]]; then
      record=${BASH_REMATCH[1]}
      asset=${BASH_REMATCH[2]}
      valid_relative_path "$record" || operation_error "relationship record path is unsafe"
      valid_relative_path "$asset" || operation_error "relationship asset path is unsafe"
      [ -f "$CAPTURE_RECORDS/$record" ] || operation_error "relationship references a missing record"
      [ -f "$CAPTURE_ASSETS/$asset" ] || operation_error "relationship references a missing asset"
    elif [[ "$line" =~ $project_pattern ]]; then
      record=${BASH_REMATCH[1]}
      valid_relative_path "$record" || operation_error "relationship record path is unsafe"
      [ -f "$CAPTURE_RECORDS/$record" ] || operation_error "relationship references a missing record"
    else
      operation_error "relationship is not a supported source-native record"
    fi
    RELATIONSHIP_COUNT=$((RELATIONSHIP_COUNT + 1))
  done < "$file"

  if [ -n "$(LC_ALL=C sort "$file" | uniq -d)" ]; then
    operation_error "relationships/native.jsonl contains a duplicate record"
  fi
}

normalised_relationships() {
  LC_ALL=C sort "$CAPTURE_RELATIONSHIPS" | sed 's|"record":"records/|"record":"source/records/|'
}

append_checksum() {
  local path="$1"
  local digest="$2"
  local line="$digest  $path"

  if [ -z "$CHECKSUM_LINES" ]; then
    CHECKSUM_LINES="$line"
  else
    CHECKSUM_LINES="${CHECKSUM_LINES}
$line"
  fi
}

add_tree_checksums() {
  local source="$1"
  local prefix="$2"
  local relative digest

  while IFS= read -r relative; do
    digest=$(sha256_file "$source/$relative")
    append_checksum "$prefix/$relative" "$digest"
  done < <(list_files "$source")
}

calculate_payload() {
  CHECKSUM_LINES=""
  add_tree_checksums "$CAPTURE_ASSETS" "assets"
  RELATIONSHIP_DIGEST=$(normalised_relationships | sha256_stdin)
  append_checksum "relationships/native.jsonl" "$RELATIONSHIP_DIGEST"
  add_tree_checksums "$CAPTURE_ORIGINALS" "source/originals"
  add_tree_checksums "$CAPTURE_RECORDS" "source/records"
  PAYLOAD_SHA256=$(printf '%s\n' "$CHECKSUM_LINES" | sha256_stdin)
  PACKAGE_ID="kep:sha256:${PAYLOAD_SHA256}"
}

copy_tree() {
  local source="$1"
  local destination="$2"
  local relative parent

  while IFS= read -r relative; do
    parent=$(dirname "$destination/$relative")
    mkdir -p "$parent"
    cp "$source/$relative" "$destination/$relative"
  done < <(list_files "$source")
}

write_kep() {
  local output="$1"

  mkdir "$output"
  OUTPUT_CREATED=1
  mkdir -p "$output/source/originals" "$output/source/records" "$output/assets" "$output/relationships" "$output/checksums"
  copy_tree "$CAPTURE_ORIGINALS" "$output/source/originals"
  copy_tree "$CAPTURE_RECORDS" "$output/source/records"
  copy_tree "$CAPTURE_ASSETS" "$output/assets"
  normalised_relationships > "$output/relationships/native.jsonl"
  printf '%s\n' "$CHECKSUM_LINES" > "$output/checksums/sha256sums.txt"
  cat > "$output/kep.toml" <<EOF
format = "kep"
format_version = "0.1.0"
package_id = "$PACKAGE_ID"
payload_sha256 = "$PAYLOAD_SHA256"
omissions = $OMISSIONS
normalisations = []
checksum_manifest = "checksums/sha256sums.txt"

[connector]
id = "$CONNECTOR_ID"
version = "$CONNECTOR_VERSION"
mode = "user-assisted"

[source]
system = "chatgpt"
capture_boundary = "$CAPTURE_BOUNDARY"

[inventory]
records = $RECORD_COUNT
assets = $ASSET_COUNT
relationships = $RELATIONSHIP_COUNT
EOF
}

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

emit_result() {
  local output="$1"
  local status="$2"
  local output_json

  if [ "$JSON_OUTPUT" -eq 1 ]; then
    output_json=$(json_escape "$output")
    printf '{"version":1,"status":"%s","output":"%s","package_id":"%s","records":%s,"assets":%s,"relationships":%s,"omissions":%s,"limitations":["local-user-provided-capture","no-browser-or-network-access","no-credential-or-repository-access","no-knowledge-extraction"]}\n' "$status" "$output_json" "$PACKAGE_ID" "$RECORD_COUNT" "$ASSET_COUNT" "$RELATIONSHIP_COUNT" "$OMISSIONS"
    return
  fi

  if [ "$status" = "dry-run" ]; then
    printf 'KEP plan: %s\n' "$output"
  else
    printf 'KEP created: %s\n' "$output"
  fi
  printf 'Package: %s\n' "$PACKAGE_ID"
  printf 'Inventory: %s records, %s assets, %s relationships\n' "$RECORD_COUNT" "$ASSET_COUNT" "$RELATIONSHIP_COUNT"
  printf 'Omissions: %s\n' "$OMISSIONS"
  printf 'Limitations: local user-provided capture only; no browser, network, credentials, repository discovery, or knowledge extraction.\n'
  [ "$status" != "dry-run" ] || printf 'Dry run: no files written.\n'
}

cleanup_output() {
  local status=$?

  if [ "${OUTPUT_CREATED:-0}" -eq 1 ] && [ "${OUTPUT_PUBLISHED:-0}" -eq 0 ]; then
    rm -rf -- "$OUTPUT_DIRECTORY"
  fi
  exit "$status"
}

import_capture() {
  local capture_argument output_argument output_parent output_name output_physical
  local entry unexpected source_count

  [ "$#" -gt 0 ] || grammar_error "acquire requires chatgpt import" "acquire"
  case "$1" in
    -h|--help) import_help; return ;;
    --*) grammar_error "capture-directory must come before options" "acquire chatgpt import" ;;
  esac
  capture_argument=$1
  shift
  output_argument=""
  DRY_RUN=0
  JSON_OUTPUT=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --output)
        [ -z "$output_argument" ] || grammar_error "--output may be provided once" "acquire chatgpt import"
        [ "$#" -ge 2 ] && [[ "$2" != --* ]] || grammar_error "--output requires a directory" "acquire chatgpt import"
        output_argument=$2
        shift 2
        ;;
      --dry-run)
        [ "$DRY_RUN" -eq 0 ] || grammar_error "--dry-run may be provided once" "acquire chatgpt import"
        DRY_RUN=1
        shift
        ;;
      --json)
        [ "$JSON_OUTPUT" -eq 0 ] || grammar_error "--json may be provided once" "acquire chatgpt import"
        JSON_OUTPUT=1
        shift
        ;;
      -h|--help) import_help; return ;;
      *) grammar_error "unknown import argument: $1" "acquire chatgpt import" ;;
    esac
  done

  [ -n "$output_argument" ] || grammar_error "--output is required" "acquire chatgpt import"
  [ ! -L "$capture_argument" ] || operation_error "capture-directory must not be a symbolic link"
  CAPTURE_DIRECTORY=$(physical_directory "$capture_argument") || operation_error "capture-directory must be an existing directory"
  [ ! -e "$output_argument" ] && [ ! -L "$output_argument" ] || operation_error "output directory already exists"
  output_parent=${output_argument%/*}
  output_name=${output_argument##*/}
  [ "$output_parent" != "$output_argument" ] || output_parent="."
  [ -n "$output_name" ] && [ "$output_name" != "." ] && [ "$output_name" != ".." ] || operation_error "output directory name is invalid"
  output_physical=$(physical_directory "$output_parent") || operation_error "output parent directory must exist"
  OUTPUT_DIRECTORY="$output_physical/$output_name"
  case "$OUTPUT_DIRECTORY" in "$CAPTURE_DIRECTORY"|"$CAPTURE_DIRECTORY"/*) operation_error "output directory must be outside capture-directory" ;; esac

  [ -f "$CAPTURE_DIRECTORY/capture.toml" ] && [ ! -L "$CAPTURE_DIRECTORY/capture.toml" ] || operation_error "capture.toml is required"
  CAPTURE_ORIGINALS="$CAPTURE_DIRECTORY/originals"
  CAPTURE_RECORDS="$CAPTURE_DIRECTORY/records"
  CAPTURE_ASSETS="$CAPTURE_DIRECTORY/assets"
  CAPTURE_RELATIONSHIPS="$CAPTURE_DIRECTORY/relationships/native.jsonl"
  [ -d "$CAPTURE_ORIGINALS" ] && [ ! -L "$CAPTURE_ORIGINALS" ] || operation_error "originals directory is required"
  [ -d "$CAPTURE_RECORDS" ] && [ ! -L "$CAPTURE_RECORDS" ] || operation_error "records directory is required"
  [ -d "$CAPTURE_ASSETS" ] && [ ! -L "$CAPTURE_ASSETS" ] || operation_error "assets directory is required"
  [ -d "$CAPTURE_DIRECTORY/relationships" ] && [ ! -L "$CAPTURE_DIRECTORY/relationships" ] || operation_error "relationships directory is required"

  while IFS= read -r entry; do
    case "${entry##*/}" in
      capture.toml|originals|records|assets|relationships) ;;
      *) operation_error "capture-directory contains an unsupported top-level entry" ;;
    esac
  done < <(find "$CAPTURE_DIRECTORY" -mindepth 1 -maxdepth 1 -print | LC_ALL=C sort)
  unexpected=$(find "$CAPTURE_DIRECTORY" ! -type d ! -type f -print -quit)
  [ -z "$unexpected" ] || operation_error "capture-directory contains an unsupported file type"

  validate_metadata "$CAPTURE_DIRECTORY/capture.toml"
  source_count=$(validate_files "$CAPTURE_ORIGINALS" "originals")
  [ "$source_count" -gt 0 ] || operation_error "originals directory must contain at least one file"
  RECORD_COUNT=$(validate_files "$CAPTURE_RECORDS" "records")
  [ "$RECORD_COUNT" -gt 0 ] || operation_error "records directory must contain at least one file"
  ASSET_COUNT=$(validate_files "$CAPTURE_ASSETS" "assets")
  validate_relationships "$CAPTURE_RELATIONSHIPS"
  calculate_payload

  if [ "$DRY_RUN" -eq 1 ]; then
    emit_result "$OUTPUT_DIRECTORY" "dry-run"
    return
  fi

  OUTPUT_CREATED=0
  OUTPUT_PUBLISHED=0
  trap cleanup_output EXIT HUP INT TERM
  write_kep "$OUTPUT_DIRECTORY"
  OUTPUT_PUBLISHED=1
  trap - EXIT HUP INT TERM
  emit_result "$OUTPUT_DIRECTORY" "created"
}

acquire() {
  [ "$#" -gt 0 ] || grammar_error "acquire requires chatgpt import" "acquire"
  case "$1" in
    -h|--help) acquire_help ;;
    chatgpt)
      shift
      [ "$#" -gt 0 ] || grammar_error "chatgpt requires import" "acquire chatgpt"
      case "$1" in
        -h|--help) chatgpt_help ;;
        import) shift; import_capture "$@" ;;
        *) grammar_error "unknown acquire chatgpt command: $1" "acquire chatgpt" ;;
      esac
      ;;
    *) grammar_error "unknown acquire command: $1" "acquire" ;;
  esac
}

help_command() {
  case "$#" in
    0) root_help ;;
    1)
      case "$1" in
        doctor) doctor_help ;;
        completion|completions) completion_help ;;
        paths) paths_help ;;
        acquire) acquire_help ;;
        *) grammar_error "unknown help topic: $1" "help" ;;
      esac
      ;;
    2)
      [ "$1" = "acquire" ] && [ "$2" = "chatgpt" ] || grammar_error "unknown help topic" "help"
      chatgpt_help
      ;;
    3)
      [ "$1" = "acquire" ] && [ "$2" = "chatgpt" ] && [ "$3" = "import" ] || grammar_error "unknown help topic" "help"
      import_help
      ;;
    *) grammar_error "unknown help topic" "help" ;;
  esac
}

case "${1:-}" in
  ""|--help|-h) root_help ;;
  help) shift; help_command "$@" ;;
  --version|-V) [ "$#" -eq 1 ] || grammar_error "--version accepts no arguments" "help"; printf 'ki %s\n' "$KI_VERSION" ;;
  doctor) [ "$#" -eq 1 ] || grammar_error "doctor accepts no arguments" "doctor"; doctor ;;
  completion|completions) [ "$#" -eq 2 ] || grammar_error "$1 requires bash or zsh" "$1"; completion "$2" ;;
  paths) [ "$#" -eq 1 ] || grammar_error "paths accepts no arguments" "paths"; ki_paths ;;
  acquire) shift; acquire "$@" ;;
  repo|user) unavailable "$1" ;;
  *) grammar_error "unknown command: $1" "help" ;;
esac
