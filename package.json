{
  "name": "@knowledgeislands/ki",
  "description": "Knowledge Islands command-line interface.",
  "version": "0.2.19",
  "author": "kris@kris.me.uk",
  "bugs": {
    "url": "https://github.com/knowledgeislands/tools-ki/issues"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "smol-toml": "1.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "syncpack": "^15.3.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/knowledgeislands/tools-ki#readme",
  "keywords": [
    "agentic-harness",
    "cli",
    "knowledge-islands"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "bunx @biomejs/biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "bunx prettier --write",
      "bunx markdownlint-cli2 --no-globs"
    ]
  },
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/tools-ki.git"
  },
  "scripts": {
    "build": "bun build --compile --outfile dist/ki src/main.ts",
    "clean": "rm -rf dist node_modules",
    "ki:deps:update": "bun update --latest",
    "ki:tools:lint-man": "mandoc -T lint man/ki.1",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "type": "module"
}
