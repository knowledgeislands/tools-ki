{
  "name": "@knowledgeislands/ki",
  "description": "Knowledge Islands command-line interface.",
  "version": "0.13.0",
  "author": "kris@kris.me.uk",
  "dependencies": {
    "commander": "^15.0.0",
    "smol-toml": "1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.6.0",
    "knip": "^6.42.0",
    "lint-staged": "^17.6.0",
    "rumdl": "^0.3.0",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/knowledgeislands/tools-ki#readme",
  "keywords": [
    "agentic-harness",
    "bun",
    "cli",
    "knowledge-islands",
    "typescript"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "rumdl check --fix"
    ]
  },
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/tools-ki.git"
  },
  "scripts": {
    "build": "bun build --compile --outfile dist/ki src/main.ts",
    "clean": "rm -rf dist node_modules",
    "ki:deps:update": "bun update --latest",
    "ki:tools:lint-man": "mandoc -T lint man/ki.1",
    "prepare": "git config core.hooksPath .githooks && bun install --frozen-lockfile --cwd tooling/boundaries",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "type": "module"
}
