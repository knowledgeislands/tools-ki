exports[`baseline role-free footer none 1`] = `
{
  "effect": {
    "arguments": [
      "exec",
      "--dangerously-bypass-approvals-and-sandbox",
      "--skip-git-repo-check",
      "--cd",
      "<fixture>/project",
      "--add-dir",
      "<fixture>/state/ki/agents/r",
      "--add-dir",
      "<fixture>/tmp/ki-agents/r/worker",
      "-m",
      "explicit-model",
      "-c",
      "model_reasoning_effort=high",
      "# Bounded task

## Rules

Tier none.

## Grant: fetch

Explicit fetch.

---

Progress protocol. Overwrite <fixture>/state/ki/agents/r/worker.status with one plain-language line 'HH:MM <zone> - what you are doing' (time from: TZ=UTC date '+%H:%M %Z') at each change of activity and at least every two minutes. When finished, write your report to <fixture>/state/ki/agents/r/worker.report.md as the owner report the ki-delegation background-run standard sets (what has been done, what is in progress, outstanding queries), then write DONE as the last line of <fixture>/state/ki/agents/r/worker.status. This is the only report path; it governs any other the brief names. Temporary output goes in <fixture>/tmp/ki-agents/r/worker/, outside every repository; ki agent close refuses while it holds anything and then removes it, so home what must survive first. For a milestone the coordinator should hear about, write the line as 'HH:MM <zone> - milestone: <text>'; when you are blocked or the work has failed, as 'HH:MM <zone> - blocked: <text>' or 'HH:MM <zone> - failed: <text>'. Do not use background subagents. Never end your session while waiting.
",
    ],
    "command": "codex",
    "workingDirectory": "<fixture>/project",
  },
  "effort": "high",
  "launch": {
    "exitCode": 0,
    "stderr": "",
    "stdout": "launched r/worker (pid 4001) in <fixture>/state/ki/agents/r
",
  },
  "model": "explicit-model",
  "prompt": "# Bounded task

## Rules

Tier none.

## Grant: fetch

Explicit fetch.

---

Progress protocol. Overwrite <fixture>/state/ki/agents/r/worker.status with one plain-language line 'HH:MM <zone> - what you are doing' (time from: TZ=UTC date '+%H:%M %Z') at each change of activity and at least every two minutes. When finished, write your report to <fixture>/state/ki/agents/r/worker.report.md as the owner report the ki-delegation background-run standard sets (what has been done, what is in progress, outstanding queries), then write DONE as the last line of <fixture>/state/ki/agents/r/worker.status. This is the only report path; it governs any other the brief names. Temporary output goes in <fixture>/tmp/ki-agents/r/worker/, outside every repository; ki agent close refuses while it holds anything and then removes it, so home what must survive first. For a milestone the coordinator should hear about, write the line as 'HH:MM <zone> - milestone: <text>'; when you are blocked or the work has failed, as 'HH:MM <zone> - blocked: <text>' or 'HH:MM <zone> - failed: <text>'. Do not use background subagents. Never end your session while waiting.
",
  "queue": {
    "exitCode": 0,
    "stderr": "",
    "stdout": "queued r/later at position 1
",
  },
  "queuedBrief": "# Bounded task
",
  "queuedRequest": {
    "allow": [
      "fetch",
    ],
    "effort": "high",
    "model": "explicit-model",
    "rules": "none",
    "runtime": "codex",
  },
  "runtime": "codex",
}
`;

